rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isLinkedCommander(openId) {
      return isSignedIn()
        && exists(currentUserPath())
        && (
          (
            'linkedOpenIds' in get(currentUserPath()).data
            && get(currentUserPath()).data.linkedOpenIds is list
            && openId in get(currentUserPath()).data.linkedOpenIds
          )
          || (
            'openId' in get(currentUserPath()).data
            && get(currentUserPath()).data.openId == openId
          )
        );
    }

    function allowedProfileFields() {
      return [
        'uid',
        'email',
        'photoUrl',
        'provider',
        'createdAt',
        'updatedAt',
        'nickname',
        'displayName',
        'profileCompletedAt'
      ];
    }

    function allowedUserUpdateFields() {
      return [
        'email',
        'photoUrl',
        'provider',
        'createdAt',
        'updatedAt',
        'nickname',
        'displayName',
        'profileCompletedAt',
        'selectedOpenId',
        'selectedOpenIdUpdatedAt'
      ];
    }

    function selectedCommanderIsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['selectedOpenId'])
        || (
          request.resource.data.selectedOpenId is string
          && (
            (
              'linkedOpenIds' in resource.data
              && resource.data.linkedOpenIds is list
              && request.resource.data.selectedOpenId in resource.data.linkedOpenIds
            )
            || (
              'openId' in resource.data
              && request.resource.data.selectedOpenId == resource.data.openId
            )
          )
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(allowedProfileFields())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.provider == 'google';

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(allowedUserUpdateFields())
        && selectedCommanderIsValid();

      allow delete: if false;
    }

    match /commanders/{openId} {
      allow read: if isLinkedCommander(openId);
      allow write: if false;
    }

    function isFullSquad(squad) {
      return squad is map
        && squad.keys().hasOnly(['nikkeIds'])
        && squad.nikkeIds is list
        && squad.nikkeIds.size() == 5
        && squad.nikkeIds[0] is string
        && squad.nikkeIds[1] is string
        && squad.nikkeIds[2] is string
        && squad.nikkeIds[3] is string
        && squad.nikkeIds[4] is string;
    }

    function hasValidSquads(squads) {
      return squads is list
        && squads.size() >= 3
        && squads.size() <= 5
        && isFullSquad(squads[0])
        && isFullSquad(squads[1])
        && isFullSquad(squads[2])
        && (squads.size() < 4 || isFullSquad(squads[3]))
        && (squads.size() < 5 || isFullSquad(squads[4]));
    }

    match /shared_decks/{deckId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200
        && request.resource.data.season is string
        && request.resource.data.raidType in ['solo', 'union']
        && hasValidSquads(request.resource.data.squadsNikkeIds)
        && request.resource.data.squadNames is list
        && request.resource.data.squadDescriptions is list
        && request.resource.data.squadWeaknessElements is list
        && request.resource.data.upvotes == 0
        && request.resource.data.downvotes == 0;

      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200
        && request.resource.data.season is string
        && request.resource.data.raidType in ['solo', 'union']
        && hasValidSquads(request.resource.data.squadsNikkeIds)
        && request.resource.data.squadNames is list
        && request.resource.data.squadDescriptions is list
        && request.resource.data.squadWeaknessElements is list
        && request.resource.data.upvotes == resource.data.upvotes
        && request.resource.data.downvotes == resource.data.downvotes;

      allow delete: if false;

      match /votes/{uid} {
        allow read, write: if false;
      }
    }

    // 아래 컬렉션은 Cloud Functions Admin SDK만 접근합니다.
    match /open_id_bindings/{document} {
      allow read, write: if false;
    }

    match /nikke_statistics/{document} {
      allow read, write: if false;
    }

    match /statistics_meta/{document} {
      allow read, write: if false;
    }

    match /guest_profile_tokens/{document} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
